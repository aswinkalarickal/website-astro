---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog | Aswin Kalarickal"
  description="Posts about whatever I'm learning or building."
>
  <h1 class="text-3xl font-bold text-slate-900">Blog</h1>
  <ul class="mt-8 space-y-8">
    {
      posts.map((post) => (
        <li>
          <a
            href={`/blog/${post.id}/`}
            class="text-xl font-semibold text-slate-900 hover:underline"
          >
            {post.data.title}
          </a>
          <p class="text-sm text-slate-500">
            {post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </p>
          <p class="mt-1 text-slate-600">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
