---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog | Aswin Kalarickal"
  description="Posts about whatever I'm learning or building."
>
  <div class="mx-auto w-full max-w-2xl px-4 py-10">
    <h1 class="font-display text-3xl font-bold text-ink">Blog</h1>
    <ul class="mt-8 space-y-8">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}/`}
              class="font-display text-xl font-semibold text-ink hover:underline"
            >
              {post.data.title}
            </a>
            <p class="font-mono text-sm text-muted">
              {post.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </p>
            <p class="mt-1 font-sans text-ink">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
