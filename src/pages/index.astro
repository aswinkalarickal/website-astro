---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <h1 class="text-4xl font-bold text-slate-900">Hi, I'm Aswin.</h1>
  <p class="mt-4 text-lg text-slate-600">
    This is a placeholder home page. The real design is coming soon &mdash; for
    now this is just a dummy boilerplate to prove the site's plumbing works:
    pages, layouts, Tailwind, and a Markdown-powered blog via Astro Content
    Collections.
  </p>
  <p class="mt-4">
    <a
      href="/blog"
      class="text-slate-900 underline underline-offset-2 hover:text-slate-600"
      >Read the blog &rarr;</a
    >
  </p>
</BaseLayout>
