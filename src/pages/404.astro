---
import BaseLayout from "../layouts/BaseLayout.astro";
import { phyllotaxis } from "../lib/grains";

const grains = phyllotaxis(20, 46).map((g, i) => ({
  ...g,
  size: 1.5 + (i % 3) * 0.5,
}));
---

<BaseLayout
  title="404 | Aswin Kalarickal"
  description="This page doesn't exist."
>
  <section
    class="relative overflow-hidden border-b border-dotted border-line px-6 py-16 text-center sm:py-20 md:py-24"
  >
    <div
      class="pointer-events-none absolute inset-0 overflow-hidden"
      aria-hidden="true"
    >
      {
        grains.map((grain) => (
          <span
            class="absolute rounded-full bg-muted/20"
            style={{
              left: `${grain.x}%`,
              top: `${grain.y}%`,
              width: `${grain.size}px`,
              height: `${grain.size}px`,
            }}
          />
        ))
      }
    </div>
    <h1
      class="relative z-10 font-display text-4xl font-bold tracking-wide text-ink uppercase sm:text-5xl md:text-6xl"
    >
      404
    </h1>
    <p class="relative z-10 mt-3 font-mono text-sm text-muted">
      Page Not Found
    </p>
  </section>

  <div class="px-6 py-12 md:py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col items-center gap-8 text-center">
      <div class="w-full border border-dotted border-line px-6 py-6 text-left font-mono text-sm text-muted">
        <p><span class="text-ink">$</span> git blame this-page</p>
        <p class="mt-2">fatal: no such path 'this-page' in HEAD</p>
        <p class="mt-2">// not a bug, just a route that never shipped</p>
      </div>
      <a
        href="/"
        class="border border-dotted border-line px-5 py-2.5 font-mono text-xs tracking-wide text-ink uppercase hover:bg-muted/10"
      >
        &larr; Back home
      </a>
    </div>
  </div>
</BaseLayout>
