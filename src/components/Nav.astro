---
const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
];
---

<header class="border-b border-slate-200">
  <nav class="mx-auto flex max-w-2xl items-center justify-between px-4 py-4">
    <a href="/" class="font-semibold text-slate-900">Aswin Kalarickal</a>
    <ul class="flex gap-4">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-slate-600 hover:text-slate-900">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
