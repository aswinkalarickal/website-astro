---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  class="grid grid-cols-[auto_1fr_auto] border-b border-dotted border-line"
>
  <div class="border-r border-dotted border-line px-6 py-4">
    <a
      href="/"
      class="font-mono text-lg font-semibold tracking-wide text-ink uppercase"
    >
      Aswin Kalarickal
    </a>
  </div>
  <div
    class="flex items-center justify-end gap-6 border-r border-dotted border-line px-6 py-4"
  >
    <a
      href="/about"
      class="font-display tracking-[2px] text-muted uppercase hover:text-ink"
    >
      About
    </a>
    <a
      href="/blog"
      class="font-display tracking-[2px] text-muted uppercase hover:text-ink"
    >
      Blog
    </a>
  </div>
  <div class="flex items-center px-6 py-4">
    <ThemeToggle />
  </div>
</header>
